# ===== Large binaries (never commit) =====
*.pt
*.npz
*.pth
*.ckpt
*.bin
*.onnx

# ===== Exception: include OOD test data for reproducibility (6.2M, 72 files) =====
!data/ood_T150/
!data/ood_T150/**

# ===== Data: exclude large/generated, keep OOD test set + scripts =====
data/data/
data/data_cache/
data/ood_T200_noise/
data/ood_T250_mask/
data_split/
data_cache/

# ===== Results: exclude checkpoints, keep JSON metrics (for reproducibility) =====
results_wsl/**/*.pt
results_wsl/**/*.npz
results/
runs/
killer_experiments/

# ===== Python cache =====
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# ===== Logs =====
*.log
*.out
*.err

# ===== Environment / IDE =====
.vscode/
.idea/
.trae/
*.swp
*.swo
.DS_Store
Thumbs.db

# ===== Temp files =====
_*.txt
safe_benchmark.log
