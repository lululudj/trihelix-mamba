_texlive/
_mamba3_ref/
data_split_m3/
m3_snapshots/
*.zip

# ===== Stage 3 results: 保留 JSON 指标用于复现, 忽略巨大 checkpoint =====
results_stage3/**/*.pt
results_stage3/**/*.npz
results_stage3/**/*.pth
results_stage3/**/*.ckpt

